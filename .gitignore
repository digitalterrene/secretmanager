# ==============================================================================
# SENIOR REPO STANDARDS: HARDENED PRODUCTION .GITIGNORE
# Tailored for Next.js / TypeScript — hardened against credential leaks,
# cache bloat, runtime dumps, and OS/IDE noise.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENTIALS, SECRETS & ENVIRONMENT FILES (ZERO TOLERANCE)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
*token*.json
serviceAccountKey.json
gcloud-key*.json
.aws/
.npmrc
.yarnrc

# ------------------------------------------------------------------------------
# 2. RUNTIME LOGS, HEAP DUMPS & DIAGNOSTICS
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
core
*.core
*.heapdump
*.heapsnapshot
folders*.txt
diag*.txt
api_logs*.txt
*.pid
*.seed

# ------------------------------------------------------------------------------
# 3. DEPENDENCY & PACKAGE MANAGER DIRECTORIES
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 4. NEXT.JS, TYPESCRIPT & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
/.next/
/out/
/build/
dist/
.turbo/
.cache/
.vercel
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 5. TESTING & CODE COVERAGE
# ------------------------------------------------------------------------------
/coverage
.nyc_output/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 7. IDE & CODE EDITOR ARTIFACTS
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
