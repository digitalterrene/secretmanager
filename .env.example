# ==============================================================================
# Secret Key Generator — Environment Variables Template
# Copy this file to `.env.local` for local development and fill in values.
# NEVER commit `.env.local` or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Cryptographic Secret Derivation (REQUIRED)
# ------------------------------------------------------------------------------
# High-entropy server-side HMAC key used for deterministic secret derivation
# and request fingerprinting (generate with: openssl rand -hex 32)
SECRET=replace_with_64_char_hex_server_secret

# Optional additional static pepper mixed into the derivation input
# (generate with: openssl rand -hex 16)
PEPPER=replace_with_optional_server_pepper

# ------------------------------------------------------------------------------
# Upstash Redis Rate Limiting (REQUIRED for /api/generate-secret)
# ------------------------------------------------------------------------------
# Provision a Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
